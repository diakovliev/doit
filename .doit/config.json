{
  "default_profile": "foundry_gpt",
  "profiles": {
    "lmstudio": {
      "api_root": "http://localhost:1234/v1",
      "model": "prism-ml/bonsai-27b"
    },
    "ollama": {
      "api_root": "http://127.0.0.1:11434/v1",
      "model": "phi4-mini:latest"
    },
    "foundry_deepseek": {
      "api_root": "https://daemondeveloperfoundry.services.ai.azure.com/openai/v1",
      "model": "DeepSeek-V4-Flash",
      "api_key_env": "DOIT_FOUNDRY_API_KEY",
      "streaming": true,
      "rate_limit": {
        "tokens_per_minute": 20000,
        "requests_per_minute": 20
      }
    },
    "foundry_gpt": {
      "api_root": "https://daemondeveloperfoundry.cognitiveservices.azure.com/openai/v1",
      "model": "gpt-5.4-nano",
      "api_key_env": "DOIT_FOUNDRY_API_KEY",
      "streaming": true,
      "rate_limit": {
        "tokens_per_minute": 250000,
        "requests_per_minute": 250
      }
    }
  },
  "tasks": {
    "test": {
      "executable": "go",
      "arguments": ["test", "./..."]
    },
    "vet": {
      "executable": "go",
      "arguments": ["vet", "./..."]
    },
    "format": {
      "executable": "gofmt",
      "arguments": ["-w"]
    },
    "format-check": {
      "executable": "gofmt",
      "arguments": ["-l"]
    },
    "lint": {
      "executable": "golangci-lint",
      "arguments": ["run"]
    },
    "security": {
      "executable": "gosec",
      "arguments": ["./..."]
    }
  }
}
